<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración base. Los valores de connectionStrings y de
  Secrets\ApiKeys.config son marcadores de posición (Sección 6.2 del
  README) y deben protegerse en el servidor de producción mediante
  aspnet_regiis -pef, tal como se documenta en
  docs/02-instructivo-despliegue-iis.md. NO deben quedar en texto plano
  en un servidor productivo.
-->
<configuration>
  <configSections>
  </configSections>

  <!--
    Las API Keys reales viven en Secrets\ApiKeys.config, fuera de este
    archivo, para poder protegerlas y rotarlas de forma independiente
    (Sección 6.1). Ver Secrets\ApiKeys.config.sample para el formato.
  -->
  <appSettings file="Secrets\ApiKeys.config">
    <add key="Sql.ConnectionStringName" value="UsuariosDb" />
    <add key="Sql.CommandTimeoutSeconds" value="30" />
    <add key="Auditoria.ConnectionStringName" value="UsuariosDb" />
    <add key="Auditoria.DirectorioRespaldo" value="App_Data\Logs" />
  </appSettings>

  <connectionStrings>
    <add name="UsuariosDb"
         connectionString="Data Source=SERVIDOR_SQL;Initial Catalog=BASE_DATOS;User ID=USUARIO_API;Password=SECRETO_PROTEGIDO;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="256" requestValidationMode="4.8" />
    <customErrors mode="On" />
    <authentication mode="None" />
    <trust level="Full" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />

    <!-- Límite de tamaño de solicitud a nivel de IIS (Sección 8). 262144 bytes = 256 KB. -->
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="262144" />
      </requestFiltering>
    </security>

    <!-- Endurecimiento básico de encabezados de respuesta. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>

    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
