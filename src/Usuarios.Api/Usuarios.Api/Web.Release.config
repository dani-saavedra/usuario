<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformación aplicada al publicar en modo Release. No incluye la
  cadena de conexión real ni las API Keys: esos valores se protegen por
  ambiente mediante aspnet_regiis (ver docs/02-instructivo-despliegue-iis.md),
  no mediante transformaciones de Web.config versionadas.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="SetAttributes" debug="false" />
    <customErrors mode="On" xdt:Transform="Replace" />
  </system.web>
</configuration>
