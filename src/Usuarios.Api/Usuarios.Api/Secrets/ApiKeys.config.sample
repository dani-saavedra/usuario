<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla de Secrets\ApiKeys.config.

  Copiar este archivo como "ApiKeys.config" (sin ".sample") en el mismo
  directorio, y reemplazar los valores por claves reales generadas de
  forma segura (por ejemplo, 32+ bytes aleatorios en Base64).

  "ApiKeys.config" NUNCA debe:
    - contener las claves reales de producción en un repositorio de código.
    - ser accesible vía HTTP (IIS ya bloquea archivos .config por defecto;
      no cambiar esa configuración).

  En producción, proteger este archivo adicionalmente con:
    aspnet_regiis -pef "appSettings" "<ruta física>\Secrets" -site "<sitio>"
  (ver docs/02-instructivo-despliegue-iis.md, sección de protección de
  configuración).

  Convención de claves: ApiKey:<NombreConsumidor> = <valor-secreto>
  Cada sistema consumidor debe tener su propia clave (Sección 6.1).
-->
<appSettings>
  <add key="ApiKey:SistemaEjemploA" value="REEMPLAZAR_POR_CLAVE_SEGURA_A" />
  <add key="ApiKey:SistemaEjemploB" value="REEMPLAZAR_POR_CLAVE_SEGURA_B" />
</appSettings>
